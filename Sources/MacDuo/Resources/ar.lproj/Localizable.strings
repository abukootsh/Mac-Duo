// Settings panel strings.
"Lid angle" = "زاوية الغطاء";
"This Mac has no lid angle sensor. Only some MacBook models have one." = "لا يحتوي هذا الماك على مستشعر لزاوية الغطاء. تتوفر هذه الميزة في بعض طرازات MacBook فقط.";
"Depth effect" = "تأثير العمق";
"Leans the screen away as the lid closes." = "يميل محتوى الشاشة للخلف أثناء إغلاق الغطاء.";
"Live rendering" = "عرض مباشر";
"Off holds the frame from when the effect started." = "عند الإيقاف يُثبَّت الإطار الذي ظهر لحظة بدء التأثير.";
"Preview effect" = "معاينة التأثير";
"Start" = "البدء";
"Timeout" = "مهلة";
"Ends the effect once the angle stops changing." = "يُنهي التأثير عندما تتوقف الزاوية عن التغيّر.";
"Start angle" = "زاوية البدء";
"The effect starts at this angle." = "يبدأ التأثير عند هذه الزاوية.";
"Full effect after" = "التأثير الكامل بعد";
"Degrees of further closing to reach full strength." = "عدد درجات الإغلاق الإضافية حتى يصل التأثير لأقصى قوته.";
"Look" = "المظهر";
"Blur" = "التمويه";
"Blur radius at the far edge." = "نصف قطر التمويه عند الحافة البعيدة.";
"Blur spread" = "انتشار التمويه";
"0 blurs the far edge only, 100 the whole picture." = "0 يموّه الحافة البعيدة فقط، و100 يموّه الصورة كاملة.";
"Dimming" = "التعتيم";
"How dark the far edge goes." = "مدى إعتام الحافة البعيدة.";
"Dimming spread" = "انتشار التعتيم";
"Everything above this height goes fully dark." = "كل ما فوق هذا الارتفاع يصبح معتماً تماماً.";
"Perspective" = "المنظور";
"Lean back" = "الميل للخلف";
"Degrees of lean per degree of closing. 1 holds it still." = "درجات الميل لكل درجة إغلاق. القيمة 1 تُبقي الصورة ثابتة.";
"0 keeps the sides parallel, 100 converges sharply." = "0 يُبقي الجوانب متوازية، و100 يجعلها تتقارب بشدة.";
"Show angle in menu bar" = "إظهار الزاوية في شريط القوائم";
"Launch at login" = "التشغيل عند تسجيل الدخول";
"Reset" = "إعادة تعيين";
"Quit" = "إنهاء";
"Screen Recording permission is required to show the depth effect." = "يلزم منح إذن تسجيل الشاشة لعرض تأثير العمق.";
"Open System Settings" = "فتح إعدادات النظام";
"Could not open System Settings. Open it manually and enable screen recording for Mac Duo under Privacy & Security." = "تعذّر فتح إعدادات النظام. افتحها يدوياً وفعّل تسجيل الشاشة لتطبيق Mac Duo ضمن الخصوصية والأمن.";
"Language" = "اللغة";
"System" = "النظام";
